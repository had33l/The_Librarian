# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=your-openai-api-key-here

# Generation model. Cost-optimised configuration: gpt-5.4-nano.
# Quality-first alternative: gpt-5.4-mini (also the default if unset).
OPENAI_MODEL=gpt-5.4-nano

# Judge model for evaluation scripts. Keep it identical across comparisons.
JUDGE_MODEL=gpt-5.4-mini
